{
  "name": "brianvanburken.github.io",
  "type": "module",
  "scripts": {
    "format:fix": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint:check": "oxlint -D correctness -D suspicious -D perf --deny-warnings",
    "test": "node --test 'scripts/*.test.js'",
    "clean": "rm -rf public",
    "serve": "aubr clean && zola serve --drafts || true",
    "build": "aubr clean && zola build && node scripts/build.js"
  },
  "dependencies": {
    "csso": "5.0.5",
    "html-minifier-terser": "7.2.0",
    "purgecss": "9.1.0",
    "shiki": "4.6.0"
  },
  "devDependencies": {
    "oxfmt": "0.79.0",
    "oxlint": "1.93.0"
  }
}
